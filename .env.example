# Copy this file to .env and set any values you need.

# Optional override for the local CS50 movies database.
# MOVIES_DB_PATH=/absolute/path/to/movies.db

# Number of queued movie downloads to process at once. Three is a good default.
# DOWNLOAD_WORKERS=3

# qBittorrent Web UI. Set the username/password unless localhost auth bypass is on.
# QBITTORRENT_URL=http://localhost:8080
# QBITTORRENT_USERNAME=
# QBITTORRENT_PASSWORD=

# Local development only: enables auto-reload and the interactive debugger.
# Never set this on a server reachable by others.
# FLASK_DEBUG=1

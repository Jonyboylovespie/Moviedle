# Copy this file to .env and set any values you need.

# TMDB API key, used for movie posters. Get one free at
# https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_api_key_here

# Optional override for the local CS50 movies database.
# MOVIES_DB_PATH=/absolute/path/to/movies.db

# Movies download automatically, keeping easy, medium and hard stocked evenly,
# until the disk is nearly full. This many GB of free space is always left.
# DISK_RESERVE_GB=5

# Number of movies to download at once. Three is a good default.
# DOWNLOAD_WORKERS=3

# Set to 0 to run without downloading anything.
# AUTO_DOWNLOAD=1

# qBittorrent Web UI. Set the username/password unless localhost auth bypass is on.
# QBITTORRENT_URL=http://localhost:8080
# QBITTORRENT_USERNAME=
# QBITTORRENT_PASSWORD=

# Local development only: enables auto-reload and the interactive debugger.
# Never set this on a server reachable by others.
# FLASK_DEBUG=1
